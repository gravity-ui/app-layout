{
  "extends": "@gravity-ui/tsconfig",
  "compilerOptions": {
    "noEmit": true,
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "types": ["node", "jest"],
    "verbatimModuleSyntax": true,
    "noUncheckedIndexedAccess": true,
    "experimentalDecorators": false,
    "resolveJsonModule": true,
  },
}
